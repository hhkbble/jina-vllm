include README.md AGENTS.md pyproject.toml uv.lock
include .python-version .gitignore .pre-commit-config.yaml
include .shellcheckrc
include model-reference.json acceptance.json NOTICE
recursive-include licenses *
recursive-include scripts *.sh
recursive-include tools *.py
recursive-include tests *.py
prune docs
prune .local
prune .venv
prune build
prune dist
global-exclude __pycache__ *.py[cod] *.log
